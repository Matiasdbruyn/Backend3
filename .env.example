# ─── Obligatorias ────────────────────────────────────────────────────────────

# Puerto donde escucha la API
PORT=8080

# URI de conexión a MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017/shipnow
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/shipnow
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ─── Opcionales ──────────────────────────────────────────────────────────────

# Nivel mínimo de log: fatal | error | warning | info | http | debug
# Si no se define: debug en development, info en production y test
LOG_LEVEL=

# Carpeta donde se guardan los archivos de log (por defecto: logs)
LOG_DIR=logs
