# ─── Entorno de testing (npm test) ───────────────────────────────────────────
# Este archivo NO tiene secretos y se versiona: define un entorno separado del
# de desarrollo (.env). Lo carga tests/setup.js antes de importar la app.

NODE_ENV=test
PORT=8081

# Base de datos de testing.
# Vacía (recomendado): los tests levantan un MongoDB en memoria con
# mongodb-memory-server, que se crea y se destruye en cada corrida.
# Para usar una instancia real, indicá una base SEPARADA de la de desarrollo
# (el nombre tiene que contener "test"), por ejemplo:
#   MONGODB_URI=mongodb://127.0.0.1:27017/shipnow_test
MONGODB_URI=

# Logs de los tests en una carpeta aparte (sin salida por consola)
LOG_LEVEL=info
LOG_DIR=logs/test
